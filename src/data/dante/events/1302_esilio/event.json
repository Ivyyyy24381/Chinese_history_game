          "scale": 0.7,
          "isClue": true,
          "dialogues": [
            {
              "speaker": "narrator",
              "speakerName": "判决书 · 1302 年 1 月 27 日",
              "text": "「但丁·阿利吉耶里，贪污受贿、勒索不义之财、反对教皇与查理殿下——罚金五千弗罗林，流放两年，终身不得任公职。」"
            },
            {
              "speaker": "dante",
              "speakerName": "但丁",
              "text": "贪污？我在执政团的每一笔账都经得起查。这罪名是编的。"
            }
          ]
        },
        {
          "id": "white_refugee",
          "name": "白党难民",
          "portrait": "/assets/dante/events/1302_esilio/npcs/white_refugee.webp",
          "position": {
            "x": 16,
            "y": 77
          },
          "scale": 1.7,
          "isClue": true,
          "dialogues": [
            {
              "speaker": "white_refugee",
              "speakerName": "白党难民",
              "text": "限期认罪缴款就能减刑——可认罪，就是承认黑党那个政府是合法的。"
            },
            {
              "speaker": "white_refugee",
              "speakerName": "白党难民",
              "text": "认，就是自己给自己定罪；不认，他们正好要你的命。两头都是死路。"
            }
          ]
        },
        {
          "id": "second_sentence",
          "name": "第二道判决",
          "portrait": "",
          "position": {
            "x": 9,
            "y": 55
          },
          "isClue": true,
          "dialogues": [
            {
              "speaker": "narrator",
              "speakerName": "第二道判决 · 1302 年 3 月 10 日",
              "text": "「上列诸人，拒不到庭——若其落入公社之手，火焚之，至死。（igne comburatur sic quod moriatur）」"
            },
            {
              "speaker": "dante",
              "speakerName": "但丁",
              "text": "火刑。他们要烧死我。"
            }
          ]
        },
