    {
      "id": "papal_hall",
      "type": "explore",
      "background": "/assets/dante/events/1302_esilio/backgrounds/papal_hall.webp",
      "title": "罗马 · 教皇接见厅 · 1301 秋",
      "narrative": "黑党要借法兰西王弟瓦卢瓦的查理「调停」佛罗伦萨。城里派出三名使节赴罗马向教皇陈情——但丁是其中之一。",
      "instruction": "在接见厅里听清楚：留下的是谁，放走的是谁。",
      "dufu_pose": "citizen/robe",
      "npcs": [
        {
          "id": "boniface",
          "name": "卜尼法斯八世",
          "portrait": "/assets/dante/npcs/boniface.webp",
          "position": {
            "x": 51,
            "y": 64
          },
          "scale": 2.3,
          "isClue": true,
          "dialogues": [
            {
              "speaker": "boniface",
              "speakerName": "卜尼法斯八世",
              "text": "佛罗伦萨的孩子们，何必多虑？朕只要你们的城顺服。"
            },
            {
              "speaker": "boniface",
              "speakerName": "卜尼法斯八世",
              "text": "其余使节回去吧，替朕传话。这位诗人——留下陪朕。"
            }
          ]
        },
        {
          "id": "papal_attendant",
          "name": "侍从",
          "portrait": "/assets/dante/events/1302_esilio/npcs/papal_attendant.webp",
          "position": {
            "x": 9,
            "y": 72
          },
          "scale": 2.3,
          "flip": true,
          "isClue": true,
          "dialogues": [
            {
              "speaker": "papal_attendant",
              "speakerName": "侍从",
              "text": "（低声）瓦卢瓦的查理殿下已带兵北上，去佛罗伦萨「调停」了。"
            },
            {
              "speaker": "papal_attendant",
              "speakerName": "侍从",
              "text": "圣父说了，您急什么呢。多住几日。"
            }
          ]
        },
        {
          "id": "dante_monologue",
          "name": "但丁的心事",
          "portrait": "",
          "position": {
            "x": 79,
            "y": 71
          },
          "isClue": true,
          "dialogues": [
            {
              "speaker": "dante",
              "speakerName": "但丁",
              "text": "调停？不带一兵一卒才叫调停。"
            },
            {
              "speaker": "dante",
              "speakerName": "但丁",
              "text": "把我留在罗马……城里要出事了。"
            }
          ]
        }
      ],
      "requiredTalks": 3,
      "nextPhase": "ritorno"
    },
    {
