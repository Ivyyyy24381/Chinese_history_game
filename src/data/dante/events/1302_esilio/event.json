          "x": 62,
          "y": 63,
          "isKey": true,
          "dialogues": [
            {
              "speaker": "narrator",
              "speakerName": "逃出来的白党人",
              "text": "「新政府在缺席审判白党的人……阿利吉耶里先生——名单上，有你。」"
            },
            {
              "speaker": "dante",
              "speakerName": "但丁",
