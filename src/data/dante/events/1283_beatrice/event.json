  "phases": [
    {
      "id": "lectern_intro",
      "type": "transition",
      "background": "/assets/dante/events/1265_firenze/backgrounds/lectern_1373.png",
      "title": "讲坛引子",
      "transitionText": "讲坛上，薄伽丘翻开《新生》。",
      "announcement": {
        "title": "讲坛",
        "text": "薄伽丘：「他一生只与她说过几次话。她嫁了银行家，他娶了政治联姻的妻子。可《神曲》里引他上天堂的不是妻子——是她。何以至此？」",
        "style": "imperial_decree"
      },
      "narrative": "",
      "nextPhase": "ponte"
    },
    {
      "id": "ponte",
      "type": "explore",
      "background": "/assets/dante/events/1283_beatrice/backgrounds/ponte_arno.png",
      "title": "圣三一桥头 · 1283",
      "narrative": "十八岁。晨光里的阿诺河。一位白衣的女子与两名女伴从桥上走来。",
      "instruction": "点击桥头的人，把这一刻记下来。",
      "dufu_pose": "youth/gazing",
      "npcs": [
        {
          "id": "beatrice_young",
          "name": "贝雅特丽切",
          "portrait": "/assets/dante/npcs/beatrice_young.png",
          "position": {
            "x": 56,
            "y": 66
          },
          "scale": 1.35,
          "isClue": true,
          "dialogues": [
            {
              "speaker": "narrator",
              "speakerName": "旁白",
              "text": "她走过桥头，转过脸来，向他微微颔首致意。"
            },
            {
              "speaker": "beatrice_young",
              "speakerName": "贝雅特丽切",
              "text": "（颔首）……"
            },
            {
              "speaker": "dante",
              "speakerName": "但丁",
              "text": "那一刻，我仿佛看到了幸福的极限。"
            },
            {
              "speaker": "dante",
              "speakerName": "但丁",
              "text": "她的致意里有一种无法言说的谦和。我如痴如醉，像逃离人群的人一样跑回房间，开始想她。"
            }
          ]
        },
        {
          "id": "cavalcanti",
          "name": "圭多·卡瓦尔坎蒂",
          "portrait": "/assets/dante/npcs/cavalcanti.png",
          "position": {
            "x": 22,
            "y": 70
          },
          "scale": 1.3,
          "isClue": true,
          "dialogues": [
            {
              "speaker": "cavalcanti",
              "speakerName": "卡瓦尔坎蒂",
              "text": "又失魂落魄了？把它写下来，杜兰特。"
            },
            {
              "speaker": "cavalcanti",
              "speakerName": "卡瓦尔坎蒂",
              "text": "我们写的是「温柔新体」——爱不是骑士的战利品，是让灵魂高贵起来的东西。"
            },
            {
              "speaker": "cavalcanti",
              "speakerName": "卡瓦尔坎蒂",
              "text": "写好了拿来给我看。你叫我第一好友，可不能拿平庸的十四行糊弄我。"
            }
          ]
        },
        {
          "id": "lady_companion",
          "name": "女伴",
          "portrait": "/assets/dante/events/1283_beatrice/npcs/lady_companion.png",
          "position": {
            "x": 74,
            "y": 70
          },
          "scale": 1.2,
          "flip": true,
          "dialogues": [
            {
              "speaker": "lady_companion",
              "speakerName": "女伴",
              "text": "那位是波尔蒂纳里家的碧丝——已许给巴尔迪家的人了。"
            },
            {
              "speaker": "lady_companion",
              "speakerName": "女伴",
              "text": "满城的诗人都在写她。她只是照旧向每个人温和地问好。"
            }
          ]
        }
      ],
      "requiredTalks": 3,
      "nextPhase": "compose"
    },
    {
