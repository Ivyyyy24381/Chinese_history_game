      "panels": [
        {
          "id": "p1_bridge",
          "x": 0,
          "y": 0,
          "w": 50,
          "h": 52,
          "dialogues": [
            {
              "speaker": "narrator",
              "speakerName": "旁白",
              "text": "桥头空了。再没有那声温和的致意。"
            }
          ]
